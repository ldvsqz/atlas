{
  "name": "atlas-gym-partner",
  "private": true,
  "version": "0.0.27",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore \"npm run test:rules:emulator\"",
    "test:rules:emulator": "vitest run tests/firestore.rules.test.js",
    "migrate:gym-id": "node scripts/migrate-gym-id.mjs",
    "verify:gym-id": "node scripts/migrate-gym-id.mjs --verify",
    "promote:admins": "node scripts/promote-admins.mjs",
    "audit": "npm audit --omit=dev && npm --prefix functions audit --omit=dev"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@mui/icons-material": "^5.11.16",
    "@mui/lab": "^5.0.0-alpha.127",
    "@mui/material": "^5.11.16",
    "@mui/styled-engine-sc": "^5.11.11",
    "@mui/x-date-pickers": "^6.0.4",
    "dayjs": "^1.11.7",
    "firebase": "^12.14.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-grid-layout": "^2.2.3",
    "react-hook-form": "^7.51.5",
    "react-icons": "^4.8.0",
    "react-router-dom": "^7.10.0",
    "react-to-print": "^3.3.0",
    "recharts": "^3.5.0",
    "styled-components": "^5.3.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react-swc": "^3.0.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "^15.15.0",
    "globals": "^16.0.0",
    "vite": "^4.2.0",
    "vitest": "^3.0.9"
  }
}
